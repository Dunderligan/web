{
	"name": "dunderligan",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "oxfmt",
		"lint": "oxfmt --check && eslint .  --cache --cache-strategy content --cache-location node_modules/.cache/eslint",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"maps:fetch": "node scripts/fetch-map-images.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.970.0",
		"arctic": "^3.7.0",
		"bits-ui": "^2.15.4",
		"drizzle-orm": "1.0.0-beta.2-ec83fa8",
		"drizzle-seed": "1.0.0-beta.2-ec83fa8",
		"iconify-icon": "^3.0.2",
		"idb-keyval": "^6.3.0",
		"postgres": "^3.4.8",
		"redis": "^5.11.0",
		"sharp": "^0.34.5",
		"slugify": "^1.6.6",
		"uuid": "^13.0.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@prgm/sveltekit-progress-bar": "^3.0.2",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-devtools-svelte": "^0.11.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22.19.7",
		"@vitejs/devtools": "^0.8.3",
		"drizzle-kit": "1.0.0-beta.2-ec83fa8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"oxfmt": "^0.73.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.1.18",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.4.0",
		"vitest": "^5.0.4"
	},
	"packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501"
}
